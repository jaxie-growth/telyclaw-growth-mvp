# ============================================================
# TelyClaw Growth Engine - 环境变量示例
# 复制为 .env 并填入你的 key（.env 已在 .gitignore 中，不会被提交）
# ============================================================

# ---------- 数据源 ----------
# simulated = 内置仿真数据（默认，无需任何 key，全流程可跑通）
# x_api     = 调用真实 X API v2（需要 X_BEARER_TOKEN，且受 Rate Limit / 付费档位限制）
DATA_SOURCE=simulated

# X API v2 Bearer Token（真实数据模式必填）
X_BEARER_TOKEN=

# ---------- 内容生成（LLM） ----------
# mock  = 内置确定性生成器（默认，不联网也能生成合规文案）
# openai = 调用任意 OpenAI 兼容的 /chat/completions 接口
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- 服务 ----------
PORT=5173
